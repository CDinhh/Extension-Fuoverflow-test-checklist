{
  "manifest_version": 3,
  "name": "FuOverflow Test Checklist",
  "version": "1.1.1",
  "description": "Tick the exam threads on FuOverflow that you have finished reviewing. Saved in localStorage.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*"
      ],
      "js": ["lightbox.js"],
      "css": ["lightbox.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
